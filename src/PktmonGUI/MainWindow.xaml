<Window x:Class="PktmonGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PktmonGUI.ViewModels"
        xmlns:v="clr-namespace:PktmonGUI.Views"
        xmlns:util="clr-namespace:PktmonGUI.Util"
        xmlns:c="clr-namespace:PktmonGUI.Controls"
        Title="PktmonGUI" Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource FS.Body}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True"
        Icon="Assets/PktmonGUI.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="F1" Command="{Binding StartTourCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <!-- Page name beside the icon; hidden when the sidebar is collapsed to icons. -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding IsSidebarCollapsed, Converter={StaticResource VisNot}}" />
        </Style>
        <!-- Collapsed, the page name moves to a tooltip. -->
        <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
            <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsSidebarCollapsed}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
        </Style>
        <Style x:Key="SessionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource B.TextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SessionTone}" Value="Running"><Setter Property="Fill" Value="{DynamicResource B.Good}" /></DataTrigger>
                <DataTrigger Binding="{Binding SessionTone}" Value="Record"><Setter Property="Fill" Value="{DynamicResource B.Bad}" /></DataTrigger>
                <DataTrigger Binding="{Binding SessionTone}" Value="Busy"><Setter Property="Fill" Value="{DynamicResource B.Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding SessionTone}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource B.Warn}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource B.Window}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Btn.Caption}" Width="40" Command="{Binding StartTourCommand}" util:Tour.Key="titlebar.help"
                                ToolTip="Tour of PktmonGUI's screens and buttons (F1)" AutomationProperties.Name="Tour">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Help}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                        </Button>
                        <!-- Theme: click flips dark/light; right-click offers Match Windows. The icon shows where a click goes. -->
                        <Button Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="Switch theme" util:Tour.Key="titlebar.theme">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
                                    <Setter Property="Width" Value="40" />
                                    <Setter Property="ToolTip" Value="Switch to the light theme (Ctrl+Shift+L). Right-click for more." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                            <Setter Property="ToolTip" Value="Switch to the dark theme (Ctrl+Shift+L). Right-click for more." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Dark" IsCheckable="True" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static util:AppTheme.Dark}"
                                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                                    <MenuItem Header="Light" IsCheckable="True" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static util:AppTheme.Light}"
                                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                                    <MenuItem Header="Match Windows" IsCheckable="True" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static util:AppTheme.System}"
                                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path StrokeThickness="1.1" Width="16" Height="16" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource I.Sun}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource I.Moon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Rectangle Width="1" Height="16" Margin="2,0,0,0" Fill="{DynamicResource B.Border}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Data="{StaticResource I.Min}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource Btn.Caption}" Click="Maximize_Click" ToolTip="Maximize">
                            <Path x:Name="MaxIcon" Data="{StaticResource I.Max}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click" ToolTip="Close">
                            <Path Data="{StaticResource I.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Stroke="{DynamicResource B.Accent}" Data="{StaticResource I.Logo}" />
                        <TextBlock Margin="8,0,0,0" Text="PktmonGUI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"
                                   Text="{Binding HostName, StringFormat='— {0}'}" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center"
                                   Text="{Binding Version}" ToolTip="{Binding StorageTooltip}" WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border Margin="10,0,0,0" Height="20" Padding="7,0" CornerRadius="3" Background="{DynamicResource B.AccentBg}"
                                BorderBrush="{DynamicResource B.AccentBorder}" BorderThickness="1" VerticalAlignment="Center"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Stroke="{DynamicResource B.Accent}" Data="{StaticResource I.Admin}" RenderTransformOrigin="0.5,0.5" Width="16" Height="16">
                                    <Path.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Administrator" FontSize="11" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Preflight (full width, no sidebar) ===== -->
            <v:PreflightView Grid.Row="1" DataContext="{Binding Preflight}"
                             Visibility="{Binding DataContext.IsPreflight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />

            <!-- ===== App (sidebar + pages) ===== -->
            <Grid Grid.Row="1" Visibility="{Binding IsPreflight, Converter={StaticResource VisNot}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0" Padding="10,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="208" />
                            <Style.Triggers>
                                <!-- Icons only; same padding, so the icons don't move. -->
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Width" Value="60" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" util:Tour.Key="nav">
                            <Button HorizontalAlignment="Left" Margin="4,0,0,8" Command="{Binding ToggleSidebarCommand}" AutomationProperties.Name="Toggle sidebar" util:Tour.Key="nav.toggle">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                                        <Setter Property="ToolTip" Value="Collapse the sidebar (Ctrl+B)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="ToolTip" Value="Expand the sidebar (Ctrl+B)" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Sidebar}" />
                            </Button>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Margin="0,0,0,2" ToolTip="Capture"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Capture}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource I.Capture}" />
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Capture" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Margin="0,0,0,2" ToolTip="Counters"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Counters}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource I.Counters}" />
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Counters" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Margin="0,0,0,2" HorizontalContentAlignment="Stretch" ToolTip="Filters"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Filters}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource VisNot}}">
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding Filters.RuleCount, Converter={StaticResource HasVis}}">
                                            <TextBlock Text="{Binding Filters.RuleCount}" FontSize="11" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource I.Filters}" />
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Filters" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Margin="0,0,0,2" ToolTip="Files"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Files}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource I.Files}" />
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Files" />
                                </StackPanel>
                            </RadioButton>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="4,10,0,0" FontSize="11.5" util:Tour.Key="nav.preflight"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Preflight}"
                                    ToolTip="Re-run the preflight checks and change adapters or the working folder">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Shield}" Width="16" />
                                    <TextBlock Text="Preflight" Margin="8,0,0,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource VisNot}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" util:Tour.Key="session">
                            <!-- Collapsed: only the state dot, lined up with the icons; the card's text is its tooltip. -->
                            <Border Height="30" Background="Transparent" ToolTipService.Placement="Right"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Vis}}">
                                <Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SessionLine1}" />
                                        <TextBlock Text="{Binding SessionLine2}" />
                                        <TextBlock Text="{Binding SessionLine3}" Visibility="{Binding SessionLine3, Converter={StaticResource HasVis}}" />
                                    </StackPanel>
                                </Border.ToolTip>
                                <Ellipse Style="{StaticResource SessionDot}" Width="8" Height="8" HorizontalAlignment="Left" Margin="16,0,0,0" />
                            </Border>
                            <Border Padding="11" Background="{DynamicResource B.Window}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource VisNot}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StateDot" Style="{StaticResource SessionDot}" />
                                        <TextBlock Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding SessionTitle}"
                                                   Foreground="{Binding Fill, ElementName=StateDot}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,7,0,0" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" Text="{Binding SessionLine1}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextDim}" FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" Text="{Binding SessionLine2}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextDim}" FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" Text="{Binding SessionLine3}"
                                               Visibility="{Binding SessionLine3, Converter={StaticResource HasVis}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,10,0,0" FontSize="11" LineHeight="16" Foreground="{DynamicResource B.TextFaint}" TextWrapping="Wrap" Text="{Binding FilterNote}"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource VisNot}}" />
                        </StackPanel>
                        <Border />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <v:CaptureView DataContext="{Binding Capture}"
                                   Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Capture}" />
                    <v:CountersView DataContext="{Binding Counters}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Counters}" />
                    <v:FiltersView DataContext="{Binding Filters}"
                                   Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Filters}" />
                    <v:FilesView DataContext="{Binding Files}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Files}" />
                </Grid>
            </Grid>

            <!-- ===== Guided tour ===== -->
            <c:TourOverlay Grid.RowSpan="2" OpenTop="36" DataContext="{Binding Tour}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}" />

            <!-- ===== Shutdown overlay ===== -->
            <Grid Grid.RowSpan="2" Background="{DynamicResource B.Scrim}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Stroke="{DynamicResource B.Accent}" Data="{StaticResource I.Refresh}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="Spin" /></Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <TextBlock Margin="12,0,0,0" Text="{Binding BusyText}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
