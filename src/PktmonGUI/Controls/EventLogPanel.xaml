<UserControl x:Class="PktmonGUI.Controls.EventLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Border Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,7" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" MinHeight="22" Padding="6,0" Click="Copy_Click"
                            ToolTip="Copy every event exactly as pktmon printed it">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Copy}" Margin="0,0,5,0" />
                            <TextBlock Text="Copy all" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count, ElementName=Self}" Style="{StaticResource T.Faint}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title, ElementName=Self}" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Self}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="{StaticResource F.Mono}" FontSize="11.5" LineHeight="17"
                                       ToolTip="{Binding Raw}" ToolTipService.ShowDuration="60000"><Run
                                       x:Name="TimeRun" Text="{Binding TimeShort, Mode=OneWay}" Foreground="{DynamicResource B.TextFaint}" /><Run
                                       x:Name="SrcRun" Text="{Binding Source, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource B.Accent}" /><Run
                                       x:Name="TextRun" Text="{Binding Text, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource B.Text2}" />
                            </TextBlock>
                            <DataTemplate.Triggers>
                                <!-- Drops, blocks and failures: the reason these providers get added. -->
                                <DataTrigger Binding="{Binding IsBad}" Value="True">
                                    <Setter TargetName="TextRun" Property="Foreground" Value="{DynamicResource B.Bad}" />
                                    <Setter TargetName="SrcRun" Property="Foreground" Value="{DynamicResource B.Bad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                    <Setter TargetName="SrcRun" Property="Text" Value="" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
