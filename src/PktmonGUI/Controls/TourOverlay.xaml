<UserControl x:Class="PktmonGUI.Controls.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Drawn over the whole window. Below OpenTop (the title bar) a transparent blocker takes every click,
         the spotlight's hole included; the title bar stays usable (move, minimize, close, ?). -->
    <Canvas x:Name="Layer">
        <Path x:Name="Scrim" Fill="{DynamicResource B.ScrimSoft}" IsHitTestVisible="False" />
        <Rectangle x:Name="Blocker" Fill="Transparent" MouseDown="Blocker_MouseDown" />
        <Rectangle x:Name="Ring" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" RadiusX="6" RadiusY="6" IsHitTestVisible="False" />

        <Border x:Name="CardBox" Style="{StaticResource Card}" Width="340" Padding="18,16" BorderBrush="{DynamicResource B.AccentBorder}"
                WindowChrome.IsHitTestVisibleInChrome="True" KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="Tour">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" MinHeight="22" Padding="5,0" Margin="8,-2,-6,0" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}" ToolTip="Close the tour (Esc)" AutomationProperties.Name="Close the tour">
                        <Path Data="{StaticResource I.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" />
                    </Button>
                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource T.H2}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding Current.Text}" Style="{StaticResource T.Muted}" FontSize="12.5" LineHeight="19"
                           Foreground="{DynamicResource B.Text2}" />
                <DockPanel Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding BackText}" Command="{Binding BackCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0" MinHeight="30" />
                        <Button x:Name="NextButton" Content="{Binding NextText}" Command="{Binding NextCommand}" Style="{StaticResource Btn.Primary}" MinHeight="30" />
                    </StackPanel>
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource T.Faint}" VerticalAlignment="Center" />
                </DockPanel>
                <CheckBox Margin="0,14,0,0" IsChecked="{Binding DontOfferAtStartup}" FontSize="12" Foreground="{DynamicResource B.TextDim}"
                          Content="Don't offer this tour at startup" />
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
