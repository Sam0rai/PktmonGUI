<UserControl x:Class="PktmonGUI.Views.FiltersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PktmonGUI.Controls"
             xmlns:vm="clr-namespace:PktmonGUI.ViewModels"
             xmlns:util="clr-namespace:PktmonGUI.Util"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Status pills: how a rule compares with the machine -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,0,7,1" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RuleStatusPill" TargetType="Border" BasedOn="{StaticResource StatusPill}">
            <Setter Property="Background" Value="{DynamicResource B.AccentBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.AccentBorder}" />
            <Setter Property="ToolTip" Value="{Binding StatusTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Applied">
                    <Setter Property="Background" Value="{DynamicResource B.GoodBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource B.WarnBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.WarnBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuleStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
            <Setter Property="Text" Value="{Binding StatusLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Applied">
                    <Setter Property="Foreground" Value="{DynamicResource B.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Read-only rule card -->
        <DataTemplate x:Key="RuleDisplay">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding MoveUpCommand}" ToolTip="Move up (changes the Filter number)" Padding="5,0">
                        <Path Data="M 3 9 L 7 5 L 11 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding MoveDownCommand}" ToolTip="Move down" Padding="5,0">
                        <Path Data="M 3 5 L 7 9 L 11 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DuplicateCommand}" ToolTip="Duplicate">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Copy}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding EditCommand}" Content="Edit" />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding RemoveCommand}" ToolTip="Remove rule">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" />
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.BorderStrong}"
                        BorderThickness="1" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" FontSize="11.5" />
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border Style="{StaticResource RuleStatusPill}"><TextBlock Style="{StaticResource RuleStatusText}" /></Border>
                    </StackPanel>
                    <TextBlock Margin="0,-4,0,8" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                               Visibility="{Binding AppliedAs, Converter={StaticResource HasVis}}">
                        <Run Text="On the machine as " /><Run Text="{Binding AppliedAs, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="And" Text="AND" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.BorderStrong}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock>
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource B.TextDim}" FontSize="11.5" /><Run Text="  " /><Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.Text}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="And" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource T.Faint}" Visibility="{Binding EmptyNote, Converter={StaticResource HasVis}}" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource B.Bad}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ErrorText, Converter={StaticResource HasVis}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Editing rule card -->
        <DataTemplate x:Key="RuleEdit">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Command="{Binding DoneCommand}" Content="Done" MinHeight="28" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding RemoveCommand}" ToolTip="Remove rule">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" />
                    </Button>
                    <Border DockPanel.Dock="Right" Style="{StaticResource RuleStatusPill}" Margin="10,0,8,0"><TextBlock Style="{StaticResource RuleStatusText}" /></Border>
                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource B.AccentBg}" BorderBrush="{DynamicResource B.Accent}"
                            BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.Accent}" />
                    </Border>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Name (optional, e.g. DNS to DC)" FontWeight="SemiBold" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="IP address or CIDR" />
                        <TextBox Text="{Binding Ip1, UpdateSourceTrigger=PropertyChanged}" Tag="any" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="An address or subnet. Matches either source or destination." Flag="-i" /></TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Transport" />
                        <ComboBox IsEditable="True" ItemsSource="{x:Static vm:RuleViewModel.TransportChoices}" Text="{Binding Transport, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ToolTip><util:Hint Text="TCP, UDP, ICMP, ICMPv6, or a protocol number (47 GRE, 50 ESP, 89 OSPF)." Flag="-t" /></ComboBox.ToolTip>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                        <TextBox Text="{Binding Port1, UpdateSourceTrigger=PropertyChanged}" Tag="any" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="A single port. Matches either source or destination." Flag="-p" /></TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MAC address" />
                        <TextBox Text="{Binding Mac1, UpdateSourceTrigger=PropertyChanged}" Tag="xx-xx-xx-xx-xx-xx" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="Matches either source or destination MAC." Flag="-m" /></TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EtherType" />
                        <ComboBox IsEditable="True" ItemsSource="{x:Static vm:RuleViewModel.EtherTypeChoices}" Text="{Binding EtherType, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ToolTip><util:Hint Text="IPv4, IPv6, ARP, or a number such as 0x88CC. Other names are sent as their number." Flag="-d" /></ComboBox.ToolTip>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="VLAN ID" />
                        <TextBox Text="{Binding Vlan, UpdateSourceTrigger=PropertyChanged}" Tag="untagged" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="802.1Q VLAN ID." Flag="-v" /></TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,14,0,0" IsEnabled="{Binding IsTcp}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TCP flags" Margin="0" VerticalAlignment="Center" />
                        <ContentControl Style="{StaticResource InfoTip}" ToolTipService.ShowOnDisabled="True">
                            <ContentControl.ToolTip><util:Hint Text="A packet matches if it carries any one of the selected flags. Set Transport to TCP to enable." Flag="-t TCP &lt;flags&gt;" /></ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource Chip}" Content="SYN" IsChecked="{Binding Syn}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="ACK" IsChecked="{Binding Ack}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="FIN" IsChecked="{Binding Fin}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="RST" IsChecked="{Binding Rst}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="PSH" IsChecked="{Binding Psh}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="URG" IsChecked="{Binding Urg}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="ECE" IsChecked="{Binding Ece}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="CWR" IsChecked="{Binding Cwr}" />
                    </WrapPanel>
                </StackPanel>

                <Expander Margin="0,12,0,0" IsExpanded="{Binding ShowAdvanced}">
                    <Expander.Header>
                        <TextBlock Text="Advanced" FontSize="12" Foreground="{DynamicResource B.Text3}" />
                    </Expander.Header>
                    <Grid Margin="20,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Second IP" />
                            <TextBox Text="{Binding Ip2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}">
                                <TextBox.ToolTip><util:Hint Text="Only traffic between the two addresses." Flag="-i &lt;ip1&gt; &lt;ip2&gt;" /></TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Second port" />
                            <TextBox Text="{Binding Port2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}">
                                <TextBox.ToolTip><util:Hint Text="Both ports must appear in the packet." Flag="-p &lt;port1&gt; &lt;port2&gt;" /></TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Second MAC" />
                            <TextBox Text="{Binding Mac2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}">
                                <TextBox.ToolTip><util:Hint Text="Only traffic between the two MAC addresses." Flag="-m &lt;mac1&gt; &lt;mac2&gt;" /></TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DSCP" />
                            <TextBox Text="{Binding Dscp, UpdateSourceTrigger=PropertyChanged}" Tag="any" Style="{StaticResource TextBox.Mono}">
                                <TextBox.ToolTip><util:Hint Text="Differentiated Services Code Point, 0–63." Flag="--dscp" /></TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <CheckBox IsChecked="{Binding Heartbeat}" Content="Cluster heartbeat">
                                <CheckBox.ToolTip><util:Hint Text="Match failover-cluster heartbeat traffic." Flag="-b" /></CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <CheckBox IsChecked="{Binding Encap}" Margin="0,0,0,6" Content="Encapsulation">
                                <CheckBox.ToolTip><util:Hint Text="Apply the fields to both inner and outer headers: VXLAN, GRE, NVGRE, IP-in-IP." Flag="-e [VXLAN port]" /></CheckBox.ToolTip>
                            </CheckBox>
                            <TextBox Text="{Binding EncapPort, UpdateSourceTrigger=PropertyChanged}" Tag="VXLAN port (default 4789)" Style="{StaticResource TextBox.Mono}"
                                     IsEnabled="{Binding Encap}" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource T.Faint}" Text="pktmon filter limits" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource InfoTip}"
                                    ToolTip="• No port ranges: add one rule per port.&#10;• No negation: there is no &#x201C;not UDP&#x201D;.&#10;• No direction: an IP or port matches either side.&#10;• For GRE, ESP or OSPF, type the protocol number in Transport (47, 50, 89)." />
                </StackPanel>

                <TextBlock Margin="0,10,0,0" Text="{Binding ErrorText}" Foreground="{DynamicResource B.Bad}" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource HasVis}}" />
                <TextBlock Margin="0,10,0,0" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap">
                    <Run Text="&gt; " Foreground="{DynamicResource B.Accent}" /><Run Text="{Binding CommandText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ===== Rules ===== -->
        <DockPanel util:Tour.Key="filters.rules">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ImportJsonCommand}" ToolTip="Import rules or presets from .json" util:Tour.Key="filters.import">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Import}" Margin="0,0,6,0" />
                                <TextBlock Text="Import .json" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ExportJsonCommand}" ToolTip="Export these rules to .json" Margin="0,0,8,0" util:Tour.Key="filters.export">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Export}" />
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding ApplyCommand}" util:Tour.Key="filters.apply">
                            <TextBlock Text="Apply to machine" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Capture filters" Style="{StaticResource T.H2}" />
                            <TextBlock Margin="12,0,0,0" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" util:Tour.Key="filters.status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentControl Style="{StaticResource InfoTip}" Margin="10,0,0,0"
                                            ToolTip="Fields on one rule are ANDed. Separate rules are ORed. That is pktmon's own logic, drawn as it behaves." />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,14,20,20">
                    <!-- Machine banner -->
                    <Border Style="{StaticResource Callout.Warn}" Margin="0,0,0,14" Visibility="{Binding MachineBanner, Converter={StaticResource HasVis}}" util:Tour.Key="filters.banner">
                        <TextBlock Text="{Binding MachineBanner}" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}" />
                    </Border>
                    <Border Style="{StaticResource Callout.Info}" Margin="0,0,0,14" Visibility="{Binding HasSnapshot, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Restore now" Command="{Binding RestoreSnapshotCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"
                                       Text="Foreign filters from before your first Apply are in a snapshot. They go back automatically when PktmonGUI closes, or now if you prefer." />
                        </DockPanel>
                    </Border>

                    <!-- Rule cards -->
                    <ItemsControl ItemsSource="{Binding Rules}" util:Tour.Key="filters.list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel x:Name="Or" Orientation="Horizontal" Margin="36,6,0,6">
                                        <Rectangle Width="1" Height="14" Fill="{DynamicResource B.BorderStrong}" Margin="0,0,10,0" />
                                        <TextBlock Text="OR" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="Card" Style="{StaticResource Card}">
                                        <ContentControl x:Name="Body" Content="{Binding}" ContentTemplate="{StaticResource RuleDisplay}" Focusable="False" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Index}" Value="1">
                                        <Setter TargetName="Or" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="Body" Property="ContentTemplate" Value="{StaticResource RuleEdit}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.DangerBorder}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,4,0,10" Visibility="{Binding RuleCount, Converter={StaticResource HasVisNot}}"
                               Text="No rules in your list. Add one, or pick a preset on the right." />

                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.DangerOutline}" Command="{Binding ClearDraftCommand}"
                                ToolTip="Empty the list on this page. The machine's filters stay until you apply.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" Margin="0,0,6,0" />
                                <TextBlock Text="Clear list" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding LoadFromMachineCommand}" Content="Load from machine" Margin="0,0,6,0"
                                ToolTip="Replace your list with the filters currently on the machine" />
                        <Button Command="{Binding AddRuleCommand}" HorizontalAlignment="Left" util:Tour.Key="filters.add">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Plus}" Margin="0,0,6,0" />
                                <TextBlock Text="Add rule" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource T.Faint}" Visibility="{Binding AtLimit, Converter={StaticResource Vis}}"
                               Text="pktmon allows at most 32 filters." Foreground="{DynamicResource B.Warn}" />

                    <!-- On the machine but not in the list: what Apply takes away -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding HasRemoved, Converter={StaticResource Vis}}" util:Tour.Key="filters.removed">
                        <TextBlock Text="{Binding RemovedHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource B.Bad}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{DynamicResource B.DangerBorder}" Padding="14,10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Keep" MinHeight="26" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.KeepMachineFilterCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="{Binding KeepTip}" ToolTipService.ShowOnDisabled="True" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextDecorations="Strikethrough"
                                                               Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource StatusPill}" Background="{DynamicResource B.BadBg}" BorderBrush="{DynamicResource B.DangerBorder}"
                                                            ToolTip="On the machine now. Apply to machine removes it, unless you Keep it.">
                                                        <TextBlock Style="{StaticResource StatusPillText}" Text="Will be removed" Foreground="{DynamicResource B.Bad}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap">
                                                    <Run Text="{Binding Args, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.TextDim}" /><Run Text="   " /><Run Text="{Binding SetBy, Mode=OneWay}" Foreground="{DynamicResource B.TextFaint}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sentence -->
                    <Border Margin="0,18,0,0" Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" util:Tour.Key="filters.sentence">
                        <TextBlock Text="{Binding SetSentence}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource B.Text2}" />
                    </Border>

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding ClearMachineCommand}" Content="Remove all from machine…" util:Tour.Key="filters.clearmachine">
                            <Button.ToolTip><util:Hint Text="Lists every filter first, and offers a snapshot of ones PktmonGUI didn't set. Your list stays as it is." Flag="pktmon filter remove" /></Button.ToolTip>
                        </Button>
                        <Border />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ===== Presets + preview ===== -->
        <Border Grid.Column="1" Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <c:CommandLogPanel DockPanel.Dock="Bottom" Margin="14" Title="Apply will run" CopyText="Copy all" ItemsSource="{Binding ApplyPreview}" MaxHeight="260" util:Tour.Key="filters.preview" />
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8" util:Tour.Key="filters.presets">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding SavePresetCommand}" Content="Save current…" FontSize="12" />
                        <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBox Text="{Binding PresetSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Search presets" Padding="24,0,6,0" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Search}" Stroke="{DynamicResource B.TextFaint}" HorizontalAlignment="Left" Margin="6,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0">
                    <StackPanel>
                        <TextBlock Text="Built in" Style="{StaticResource T.Section}" Margin="0,4,0,4" />
                        <ItemsControl ItemsSource="{Binding FilteredBuiltIn}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddPresetCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource Btn.Ghost}" Padding="8,6" Margin="0,0,0,2" ToolTip="{Binding Description}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.TextDim}"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                            <TextBlock Text="Saved on this machine" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource InfoTip}">
                                <ContentControl.ToolTip>
                                    <TextBlock><Run Text="Saved to " /><Run Text="{Binding PresetsPath, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" /><Run Text="." /></TextBlock>
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredSaved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="4,0"
                                                Command="{Binding DataContext.DeletePresetCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="Delete preset">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" />
                                        </Button>
                                        <Button Command="{Binding DataContext.AddPresetCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource Btn.Ghost}" Padding="8,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.TextDim}"
                                                           MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
