<Window x:Class="PktmonGUI.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource FS.Body}"
        BorderBrush="{DynamicResource B.BorderStrong}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,0">
                <Path x:Name="KindIcon" Style="{StaticResource Icon}" Stroke="{DynamicResource B.Accent}" Data="{StaticResource I.Info}" />
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Background="{DynamicResource B.Sidebar}">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}" LineHeight="19" />
                <TextBox x:Name="InputBox" Margin="0,12,0,0" Visibility="Collapsed" />
                <TextBox x:Name="DetailBox" Margin="0,12,0,0" Visibility="Collapsed" IsReadOnly="True" Style="{StaticResource TextBox.Mono}"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
