<UserControl x:Class="PktmonGUI.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PktmonGUI.Controls"
             xmlns:m="clr-namespace:PktmonGUI.Model"
             xmlns:util="clr-namespace:PktmonGUI.Util">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="5,0,22,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Packet grid header: title + sort arrow (click to sort), filter box underneath. -->
        <DataTemplate x:Key="FilterHeaderTemplate">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Path x:Name="Arrow" DockPanel.Dock="Right" Width="7" Height="4" Stretch="Fill" Fill="{DynamicResource B.Accent}"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,0,0" Data="M 0 4 L 3.5 0 L 7 4 Z" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=300}" MinHeight="22" Padding="4,0"
                         FontSize="11.5" FontWeight="Normal" Tag="filter" ToolTip="{Binding Help}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 3.5 4 L 7 0 Z" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="FilterHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource B.Sidebar}" />
            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
            <Setter Property="FontSize" Value="{StaticResource FS.Tiny}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click to sort: ascending, descending, then back to capture order" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,1" Padding="6,5,6,5">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" TextBlock.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B.Text2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding StartStopCommand}" util:Tour.Key="capture.start" MinWidth="96" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource B.Danger}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.DangerBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="StartIcon" Style="{StaticResource Icon}" Stroke="White" Fill="White" Data="{StaticResource I.Play}" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="StartLabel" Text="{Binding StartText}" />
                    </StackPanel>
                </Button>

                <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" util:Tour.Key="capture.options">
                    <Border Style="{StaticResource SegHost}" Margin="0,0,12,6" util:Tour.Key="capture.mode">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" GroupName="mode" Content="Live"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=Live}">
                                <RadioButton.ToolTip><util:Hint Text="Packets stream into the grid as they arrive." Flag="--log-mode real-time" /></RadioButton.ToolTip>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Seg}" GroupName="mode" Content="Record"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=Record}">
                                <RadioButton.ToolTip><util:Hint Text="Write an .etl file for Wireshark. Packets load into the grid after Stop." Flag="--file-name" /></RadioButton.ToolTip>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Seg}" GroupName="mode" Content="Counters only"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=CountersOnly}">
                                <RadioButton.ToolTip><util:Hint Text="Count packets per component. No packet detail, nothing written to disk." Flag="--counters-only" /></RadioButton.ToolTip>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6" util:Tour.Key="capture.adapter">
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Adapter" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Width="330" MaxDropDownHeight="420"
                                  ToolTip="{Binding SelectedTarget.Detail}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Command="{Binding GoToFiltersCommand}" Margin="0,0,12,6" Padding="10,0" ToolTip="Edit rules on the Filters page" util:Tour.Key="capture.rules">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Filters}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RulesSummary}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding RulesDetail}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="8,0,0,0" Text="not applied" FontSize="11.5" Foreground="{DynamicResource B.Warn}"
                                       Visibility="{Binding RulesNotApplied, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Pill}" Margin="0,0,12,6" Visibility="{Binding IsCountersOnly, Converter={StaticResource VisNot}}" util:Tour.Key="capture.fullpacket">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding FullPacket}" VerticalAlignment="Center" Content="Full packet">
                                <CheckBox.ToolTip><util:Hint Text="Log whole packets. pktmon's default of 128 bytes cuts DNS answers and CDP/LLDP detail." Flag="--pkt-size 0" /></CheckBox.ToolTip>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding FullPacket, Converter={StaticResource VisNot}}">
                                <TextBox Text="{Binding SnapLength, UpdateSourceTrigger=PropertyChanged}" Width="52" MinHeight="22" Margin="8,0,6,0" Style="{StaticResource TextBox.Mono}">
                                    <TextBox.ToolTip><util:Hint Text="Bytes logged from each packet." Flag="--pkt-size" /></TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="bytes" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Pill}" Margin="0,0,12,6" Visibility="{Binding IsCountersOnly, Converter={StaticResource VisNot}}" util:Tour.Key="capture.processes">
                        <CheckBox IsChecked="{Binding AttributeProcesses}" VerticalAlignment="Center" Content="Processes">
                            <CheckBox.ToolTip><util:Hint Text="Show which process owns each packet, using an ETW session that runs beside pktmon. DNS lookups show the process that asked for the name. Filter the grid with pid:1234 or proc:name." Flag="Kernel-Network · Kernel-Process · DNS-Client" /></CheckBox.ToolTip>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Pill}" Margin="0,0,12,6" Visibility="{Binding IsLive, Converter={StaticResource Vis}}" util:Tour.Key="capture.pcapng">
                        <CheckBox IsChecked="{Binding SaveLivePcap}" VerticalAlignment="Center" Content="Save pcapng">
                            <CheckBox.ToolTip><util:Hint Text="Also save the real packet bytes to the working folder for Wireshark. With Processes on, each packet gets a process comment when you stop." Flag="live-yyyyMMdd-HHmmss.pcapng" /></CheckBox.ToolTip>
                        </CheckBox>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6" Visibility="{Binding IsRecord, Converter={StaticResource Vis}}" util:Tour.Key="capture.record">
                        <TextBlock Style="{StaticResource ToolLabel}" Text="File" />
                        <TextBox Text="{Binding RecordFileName, UpdateSourceTrigger=PropertyChanged}" Width="210" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="Written to the working folder." Flag="--file-name" /></TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Max size" Margin="10,0,6,0" />
                        <TextBox Text="{Binding RecordSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="52" Style="{StaticResource TextBox.Mono}">
                            <TextBox.ToolTip><util:Hint Text="Maximum log size (default 200 MB). In multi-file mode pktmon starts the next file late: it writes in 16 MB buffers, so under load each file ends up well past this size, often several hundred MB." Flag="--file-size" /></TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Style="{StaticResource ToolLabel}" Text="MB" Margin="6,0,10,0" />
                        <ComboBox ItemsSource="{Binding LogModes}" SelectedItem="{Binding RecordLogMode}" Width="110">
                            <ComboBox.ToolTip><util:Hint Text="When the log fills: circular overwrites the oldest packets, multi-file starts a new file, memory keeps everything in RAM and writes on Stop." Flag="--log-mode" /></ComboBox.ToolTip>
                        </ComboBox>
                    </StackPanel>

                    <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,0,6" Click="ToggleAdvanced_Click" util:Tour.Key="capture.advancedbutton">
                        <TextBlock Text="Advanced…" FontSize="12" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Advanced options ===== -->
        <Border Grid.Row="1" Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="{Binding ShowAdvanced, Converter={StaticResource Vis}}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" util:Tour.Key="capture.advanced">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource T.Section}" Text="Packet type" Margin="0,0,0,5" />
                    <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" GroupName="ptype" Content="All" IsChecked="{Binding PacketType, Converter={StaticResource EnumEq}, ConverterParameter=All}">
                                <RadioButton.ToolTip><util:Hint Text="Normal flow and dropped packets." Flag="--type all" /></RadioButton.ToolTip>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Seg}" GroupName="ptype" Content="Flow" IsChecked="{Binding PacketType, Converter={StaticResource EnumEq}, ConverterParameter=Flow}">
                                <RadioButton.ToolTip><util:Hint Text="Normal packet flow only." Flag="--type flow" /></RadioButton.ToolTip>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Seg}" GroupName="ptype" Content="Drops" IsChecked="{Binding PacketType, Converter={StaticResource EnumEq}, ConverterParameter=Drop}">
                                <RadioButton.ToolTip><util:Hint Text="Only packets the stack discarded, with the drop reason." Flag="--type drop" /></RadioButton.ToolTip>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource T.Section}" Text="Event mask" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Flags, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource TextBox.Mono}" Tag="0x032">
                        <TextBox.ToolTip><util:Hint Text="0x001 errors · 0x002 component/counter/filter summary · 0x004 NBL group info · 0x008 NBL metadata · 0x010 raw packet · 0x020 component changes. Default 0x032." Flag="--flags" /></TextBox.ToolTip>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource T.Section}" Text="Extra ETW providers" Margin="0,0,0,5" />
                    <TextBox Text="{Binding ProvidersText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="46" MaxHeight="80"
                             VerticalContentAlignment="Top" Padding="6,4" Style="{StaticResource TextBox.Mono}" VerticalScrollBarVisibility="Auto"
                             Tag="Microsoft-Windows-TCPIP 0xFF 4">
                        <TextBox.ToolTip><util:Hint Text="Trace more ETW providers alongside the packets. One per line: name or GUID, then optional keywords and level." Flag="--trace --provider &lt;name&gt; [--keywords] [--level]" /></TextBox.ToolTip>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource T.Section}" Text="Grid row cap" Margin="0,0,0,5" />
                    <TextBox Text="{Binding RowCap, UpdateSourceTrigger=LostFocus}" Width="90" Style="{StaticResource TextBox.Mono}"
                             ToolTip="Oldest rows are dropped past this many. Minimum 1,000." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Hint / banner ===== -->
        <Border Grid.Row="2" Padding="20,8" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" util:Tour.Key="capture.banner">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource B.BadBg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Banner, Converter={StaticResource HasVisNot}}">
                    <TextBlock Style="{StaticResource T.Muted}" Text="{Binding ModeHint}" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource InfoTip}" ToolTip="{Binding ModeHintDetail}" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding MultiFileSizeWarning, Converter={StaticResource HasVis}}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Warn}" Stroke="{DynamicResource B.Warn}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource T.Muted}" Foreground="{DynamicResource B.Warn}" Text="{Binding MultiFileSizeWarning}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <DockPanel Visibility="{Binding Banner, Converter={StaticResource HasVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" MinHeight="20" Padding="4,0" Click="DismissBanner_Click" ToolTip="Dismiss">
                        <Path Data="{StaticResource I.Close}" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1.1" Width="10" Height="10" />
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding LastPcapPath, Converter={StaticResource HasVis}}">
                        <Button Style="{StaticResource Btn.Link}" Content="Open in Wireshark" FontSize="12" Command="{Binding OpenLastPcapCommand}" Margin="0,0,14,0"
                                Visibility="{Binding CanOpenInWireshark, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource Btn.Link}" Content="Show in folder" FontSize="12" Command="{Binding ShowLastPcapCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Stats bar ===== -->
        <Border Grid.Row="3" Height="38" Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="200" Margin="0,0,12,0" util:Tour.Key="capture.find">
                        <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged, Delay=250}" MinHeight="26" Tag="Find in rows (IP, proto, text)" Padding="24,0,6,0" FontSize="12" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Search}" Stroke="{DynamicResource B.TextFaint}" HorizontalAlignment="Left" Margin="6,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="{Binding AttributionText}" ToolTip="{Binding AttributionTooltip}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding AttributionText, Converter={StaticResource HasVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AttributionWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource Btn.Link}" Command="{Binding ClearFiltersCommand}" Content="Clear filters" FontSize="12" Margin="0,0,14,0" util:Tour.Key="capture.clearfilters"
                            VerticalAlignment="Center" Visibility="{Binding HasFilters, Converter={StaticResource Vis}}" />
                    <CheckBox IsChecked="{Binding AutoScroll}" Content="Auto-scroll" FontSize="12" Foreground="{DynamicResource B.TextDim}" Margin="0,0,12,0"
                              ToolTip="Follow new packets. Applies while the grid is in capture order (# ascending)." />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ClearCommand}" ToolTip="Clear the grid (the capture keeps running)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding SaveRowsCommand}" ToolTip="Save the rows as pktmon text">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Save}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" util:Tour.Key="capture.stats">
                    <TextBlock Style="{StaticResource StatLabel}" Text="Matched" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Matched, Converter={StaticResource N0}}" />
                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource B.Rx}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="RX" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Rx, Converter={StaticResource N0}}" />
                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource B.Tx}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="TX" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Tx, Converter={StaticResource N0}}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="Dropped" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Dropped, Converter={StaticResource N0}}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="Elapsed" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Elapsed}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding RowsText}" Foreground="{DynamicResource B.TextFaint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Grid + detail ===== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PacketGrid" util:Tour.Key="capture.grid" ItemsSource="{Binding PacketsView}" SelectedItem="{Binding SelectedPacket}"
                      CanUserSortColumns="True" Sorting="PacketGrid_Sorting" ColumnHeaderStyle="{StaticResource FilterHeader}"
                      RowHeight="24" FontSize="12">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDrop}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B.Bad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy pktmon lines" Command="{Binding CopyPacketCommand}" />
                        <MenuItem Header="Show only this process" Command="{Binding ShowOnlyProcessCommand}" />
                        <MenuItem Header="Copy process path" Command="{Binding CopyProcessPathCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn SortMemberPath="Number" Binding="{Binding Number}" Width="52" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTextColumn SortMemberPath="Time" Binding="{Binding TimeShort}" Width="96" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTemplateColumn SortMemberPath="Dir" Width="80" MinWidth="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirText}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding Direction, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn SortMemberPath="Source" Binding="{Binding SrcIp}" Width="138" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTextColumn SortMemberPath="SrcPort" Binding="{Binding SrcPort}" Width="70" MinWidth="44" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTextColumn SortMemberPath="Destination" Binding="{Binding DstIp}" Width="138" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTextColumn SortMemberPath="DstPort" Binding="{Binding DstPort}" Width="70" MinWidth="44" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTextColumn SortMemberPath="Protocol" Binding="{Binding Protocol}" Width="64" MinWidth="64" ElementStyle="{StaticResource Cell.Mono}" />
                    <DataGridTemplateColumn SortMemberPath="Process" Width="150" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="P" Text="{Binding ProcessText}" ToolTip="{Binding Attribution.Tooltip}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Attribution.State}" Value="Pending">
                                        <Setter TargetName="P" Property="Foreground" Value="{DynamicResource B.TextFaint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Attribution.State}" Value="NoProcess">
                                        <Setter TargetName="P" Property="Foreground" Value="{DynamicResource B.TextFaint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Attribution.State}" Value="Unknown">
                                        <Setter TargetName="P" Property="Foreground" Value="{DynamicResource B.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Attribution.State}" Value="System">
                                        <Setter TargetName="P" Property="Foreground" Value="{DynamicResource B.Text3}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn SortMemberPath="Bytes" Binding="{Binding Length}" Width="56" MinWidth="56" ElementStyle="{StaticResource Cell.Mono}" />
                    <!-- Fixed width, not *, so the grid can scroll sideways; code-behind stretches it into spare room. -->
                    <DataGridTextColumn x:Name="InfoColumn" SortMemberPath="Info" Binding="{Binding Info}" Width="600" MinWidth="80" ElementStyle="{StaticResource Cell.Text}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource T.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40"
                       Visibility="{Binding Packets.Count, Converter={StaticResource HasVisNot}}" IsHitTestVisible="False">
                <Run Text="{Binding EmptyTitle, Mode=OneWay}" /><LineBreak /><Run Text="{Binding EmptyHint, Mode=OneWay}" />
            </TextBlock>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource B.Border}" ResizeBehavior="PreviousAndNext" />

            <!-- Detail pane -->
            <Border Grid.Column="2" Background="{DynamicResource B.Sidebar}" util:Tour.Key="capture.decoder">
                <Grid>
                    <TextBlock Style="{StaticResource T.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select a packet to decode it."
                               Visibility="{Binding SelectedPacket, Converter={StaticResource HasVisNot}}" />
                    <DockPanel Visibility="{Binding SelectedPacket, Converter={StaticResource HasVis}}">
                        <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Section}" Text="{Binding SelectedPacket.Number, StringFormat='Packet {0}'}" />
                                <TextBlock Margin="0,3,0,10" Text="{Binding SelectedTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left" Height="28">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Seg}" GroupName="detail" Content="Decoded" Height="24"
                                                     IsChecked="{Binding ShowRaw, Converter={StaticResource Not}}" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="detail" Content="Raw pktmon" Height="24" IsChecked="{Binding ShowRaw}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                            <Grid>
                                <!-- Decoded -->
                                <ItemsControl ItemsSource="{Binding SelectedPacket.Sections}" Visibility="{Binding ShowRaw, Converter={StaticResource VisNot}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Section}" Margin="0,0,0,5" />
                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource B.TextDim}" FontSize="12" TextWrapping="Wrap" />
                                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                                                         Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Raw -->
                                <StackPanel Visibility="{Binding ShowRaw, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource T.Muted}" Text="Raw pktmon output for this frame" />
                                        <ContentControl Style="{StaticResource InfoTip}" ToolTip="Exactly what pktmon printed: a metadata line, then a tcpdump-style line." />
                                    </StackPanel>
                                    <Border Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="3" Padding="10,8">
                                        <TextBox Text="{Binding SelectedPacket.RawText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Text2}" />
                                    </Border>
                                    <TextBlock Text="Reading the symbols" Style="{StaticResource T.Section}" Margin="0,14,0,6"
                                               Visibility="{Binding SelectedPacket.Legend.Count, Converter={StaticResource HasVis}}" />
                                    <ItemsControl ItemsSource="{Binding SelectedPacket.Legend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Symbol}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.Accent}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Meaning}" FontSize="12" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Loading overlay (Record mode after stop) -->
            <Border Grid.ColumnSpan="3" Background="{DynamicResource B.ScrimSoft}" Visibility="{Binding LoadingText, Converter={StaticResource HasVis}}">
                <TextBlock Text="{Binding LoadingText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
            </Border>
        </Grid>

        <!-- ===== Session log, and the ETW provider events beside it when there are any ===== -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid Height="118">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding HasEvents, Converter={StaticResource StarIfTrue}}" />
                </Grid.ColumnDefinitions>
                <c:CommandLogPanel Title="Commands this session ran" CopyText="Copy all" ItemsSource="{Binding Log.Entries}" Follow="True" util:Tour.Key="capture.log" />
                <Border Grid.Column="1" Width="10" Visibility="{Binding HasEvents, Converter={StaticResource Vis}}" />
                <c:EventLogPanel Grid.Column="2" ItemsSource="{Binding Events}" Count="{Binding EventsText}" Follow="True"
                                 Visibility="{Binding HasEvents, Converter={StaticResource Vis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
