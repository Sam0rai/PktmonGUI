<UserControl x:Class="PktmonGUI.Views.PreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PktmonGUI.Controls"
             xmlns:util="clr-namespace:PktmonGUI.Util">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource B.Sidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel MaxWidth="980">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RunChecksCommand}" Margin="0,0,8,0" util:Tour.Key="preflight.rerun">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Refresh}" Margin="0,0,7,0" />
                            <TextBlock Text="Re-run checks" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding ContinueCommand}" util:Tour.Key="preflight.continue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continue to capture" />
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.ChevronRight}" Margin="6,0,0,0" Stroke="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource T.Muted}" Text="Nothing has been changed on this machine yet." Visibility="{Binding HasMutated, Converter={StaticResource VisNot}}" />
                    <TextBlock Style="{StaticResource T.Muted}" Foreground="{DynamicResource B.Warn}" Text="{Binding ContinueHint}" Visibility="{Binding ContinueHint, Converter={StaticResource HasVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" Margin="28,24,28,24">
                <TextBlock Text="Preflight" Style="{StaticResource T.H1}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource T.Muted}" FontSize="13"
                           Text="Checks that decide whether a capture is usable." />

                <!-- Checks -->
                <Border Style="{StaticResource Card}" Padding="0" util:Tour.Key="preflight.checks">
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="{Binding Action3Text}" Command="{Binding Action3}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0"
                                                    Visibility="{Binding Action3Text, Converter={StaticResource HasVis}}" />
                                            <Button Content="{Binding Action2Text}" Command="{Binding Action2}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0"
                                                    Visibility="{Binding Action2Text, Converter={StaticResource HasVis}}" />
                                            <Button Content="{Binding ActionText}" Command="{Binding Action}"
                                                    Visibility="{Binding ActionText, Converter={StaticResource HasVis}}" />
                                        </StackPanel>
                                        <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,12,0">
                                            <Path Data="{StaticResource I.Circle}" Stroke="{Binding State, Converter={StaticResource ToneBrush}}" StrokeThickness="1.3" />
                                            <Path Data="{Binding State, Converter={StaticResource CheckGeo}}" Stroke="{Binding State, Converter={StaticResource ToneBrush}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}" FontSize="12" LineHeight="18">
                                                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Mono, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.Text2}" /><Run Text="{Binding After, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Adapter -->
                <DockPanel Margin="0,24,0,6">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowAllComponents}" FontSize="12" Content="Show all components" util:Tour.Key="preflight.showall">
                        <CheckBox.ToolTip><util:Hint Text="Also list filter drivers, protocols, vSwitch ports and hidden components, to capture at a specific point in the stack, e.g. to see where a packet is dropped." Flag="pktmon list --all --include-hidden" /></CheckBox.ToolTip>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Capture adapter" Style="{StaticResource T.H2}" />
                        <ContentControl Style="{StaticResource InfoTip}" Margin="8,0,0,0"
                                        ToolTip="Without one, pktmon captures every packet at each layer, so each appears several times. Component IDs change at reboot, so PktmonGUI matches on MAC and re-reads the ID at launch." />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource T.Muted}" Margin="0,0,0,10"
                           Text="Choose one or more components to capture on." />
                <Border Style="{StaticResource Callout.Bad}" Margin="0,0,0,10" Visibility="{Binding AdapterError, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding AdapterError}" TextWrapping="Wrap" Foreground="{DynamicResource B.Bad}" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="0" util:Tour.Key="preflight.adapters">
                    <DataGrid ItemsSource="{Binding Adapters}" Background="Transparent" MaxHeight="340" RowHeight="44" SelectionMode="Single"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ADAPTER" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource B.TextDim}" /><Run Text="{Binding Warning, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" Foreground="{DynamicResource B.Warn}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="IPV4" Binding="{Binding IPv4}" Width="120" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTemplateColumn Header="LINK" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="L" Text="{Binding Link}" VerticalAlignment="Center" Foreground="{DynamicResource B.TextDim}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LinkUp}" Value="True">
                                                <Setter TargetName="L" Property="Foreground" Value="{DynamicResource B.Good}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="54" ElementStyle="{StaticResource Cell.Mono}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <c:CommandLogPanel Margin="0,24,0,0" Title="Commands run" CopyText="Copy" ItemsSource="{Binding Log.Entries}" MaxHeight="220" Follow="True" util:Tour.Key="preflight.log" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
