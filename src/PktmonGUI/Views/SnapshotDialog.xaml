<Window x:Class="PktmonGUI.Views.SnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Width="720" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource FS.Body}"
        BorderBrush="{DynamicResource B.BorderStrong}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource B.Titlebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.CaptionClose}" Height="40" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                    <Path Data="{StaticResource I.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" />
                </Button>
                <Path Style="{StaticResource Icon}" Stroke="{DynamicResource B.Warn}" Data="{StaticResource I.Shield}" />
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Background="{DynamicResource B.Sidebar}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Click="Copy_Click" Style="{StaticResource Btn.Ghost}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Copy}" Margin="0,0,6,0" />
                        <TextBlock Text="Copy the list first" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ApplyButton" Margin="8,0,0,0" Style="{StaticResource Btn.Danger}" Click="Apply_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Headline" Style="{StaticResource T.H2}" TextWrapping="Wrap" />
            <TextBlock x:Name="Explain" Grid.Row="1" Margin="0,8,0,12" Style="{StaticResource T.Muted}" FontSize="12.5" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.MonoDim}" Text="from pktmon filter list" VerticalAlignment="Center" />
                            <TextBlock Text="Currently on this machine" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="OwnerText" Margin="10,0,0,0" Foreground="{DynamicResource B.Warn}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="FilterGrid" Background="Transparent" RowHeight="24">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="NAME" Binding="{Binding Rule.Name}" Width="150" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="MATCH" Binding="{Binding Rule.ShortLabel}" Width="*" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="AS FILTER ADD" Binding="{Binding Rule.ArgsSummary}" Width="220" ElementStyle="{StaticResource Cell.Mono}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel x:Name="SnapshotPanel" Grid.Row="3" Margin="0,14,0,0">
                <CheckBox x:Name="SaveCheck" IsChecked="True" FontWeight="SemiBold" Content="Save this set and put it back when I stop capturing" />
                <TextBlock Margin="21,6,0,0" Style="{StaticResource T.Muted}">
                    <Run Text="Written to " /><Run x:Name="PathRun" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.Text2}" /><Run Text=" and replayed as " /><Run Text="pktmon filter add" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.Text2}" /><Run Text=" lines on stop, or when PktmonGUI closes." />
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="Caveat" Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource T.Faint}"
                       Text="Two things worth knowing: the restored rules come back owned by PktmonGUI rather than by the original owner, and Defender for Endpoint normally rebuilds its own set on its next cycle or at reboot. A reboot clears every pktmon filter anyway, snapshot or not." />
        </Grid>
    </DockPanel>
</Window>
