<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: same tokens as Dark.xaml, accents darkened to stay readable on white. Swapped at runtime by ThemeManager, so the views use DynamicResource for B.* and C.*. -->
    <Color x:Key="C.Titlebar">#E3E6EB</Color>
    <Color x:Key="C.App">#ECEEF2</Color>
    <Color x:Key="C.Sidebar">#F1F3F6</Color>
    <Color x:Key="C.Window">#FAFBFC</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Input">#F3F5F8</Color>
    <Color x:Key="C.NavSelected">#DDEFED</Color>
    <Color x:Key="C.RowHover">#EEF2F7</Color>
    <Color x:Key="C.RowSelected">#D5E7F6</Color>
    <Color x:Key="C.Border">#D8DDE4</Color>
    <Color x:Key="C.BorderStrong">#BAC2CD</Color>
    <Color x:Key="C.Text">#161B22</Color>
    <Color x:Key="C.Text2">#2B333E</Color>
    <Color x:Key="C.Text3">#4A5462</Color>
    <Color x:Key="C.TextDim">#5F6977</Color>
    <Color x:Key="C.TextFaint">#858E9B</Color>
    <Color x:Key="C.Accent">#1D8780</Color>
    <Color x:Key="C.AccentHover">#14706A</Color>
    <Color x:Key="C.AccentDeep">#1F7A74</Color>
    <Color x:Key="C.AccentBg">#E2F3F1</Color>
    <Color x:Key="C.AccentBorder">#A6D5CF</Color>
    <Color x:Key="C.Good">#2A8752</Color>
    <Color x:Key="C.GoodBg">#E2F4E9</Color>
    <Color x:Key="C.Warn">#9A6700</Color>
    <Color x:Key="C.WarnBg">#FDF3DA</Color>
    <Color x:Key="C.WarnBorder">#E6C56E</Color>
    <Color x:Key="C.Bad">#C0392F</Color>
    <Color x:Key="C.BadBg">#FBE5E2</Color>
    <Color x:Key="C.Danger">#B3362D</Color>
    <Color x:Key="C.DangerBorder">#C24A40</Color>
    <Color x:Key="C.Rx">#2869AE</Color>
    <Color x:Key="C.Tx">#A35B12</Color>
    <Color x:Key="C.Purple">#6650C2</Color>
    <Color x:Key="C.Blue">#3473BD</Color>
    <Color x:Key="C.Orange">#A9661A</Color>
    <Color x:Key="C.Scrim">#CCECEEF2</Color>
    <Color x:Key="C.ScrimSoft">#B3ECEEF2</Color>
    <Color x:Key="C.RowLine">#E6E9EE</Color>

    <SolidColorBrush x:Key="B.Titlebar" Color="{StaticResource C.Titlebar}" />
    <SolidColorBrush x:Key="B.App" Color="{StaticResource C.App}" />
    <SolidColorBrush x:Key="B.Sidebar" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Input" Color="{StaticResource C.Input}" />
    <SolidColorBrush x:Key="B.NavSelected" Color="{StaticResource C.NavSelected}" />
    <SolidColorBrush x:Key="B.RowHover" Color="{StaticResource C.RowHover}" />
    <SolidColorBrush x:Key="B.RowSelected" Color="{StaticResource C.RowSelected}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="B.AccentDeep" Color="{StaticResource C.AccentDeep}" />
    <SolidColorBrush x:Key="B.AccentBg" Color="{StaticResource C.AccentBg}" />
    <SolidColorBrush x:Key="B.AccentBorder" Color="{StaticResource C.AccentBorder}" />
    <SolidColorBrush x:Key="B.Good" Color="{StaticResource C.Good}" />
    <SolidColorBrush x:Key="B.GoodBg" Color="{StaticResource C.GoodBg}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.WarnBg" Color="{StaticResource C.WarnBg}" />
    <SolidColorBrush x:Key="B.WarnBorder" Color="{StaticResource C.WarnBorder}" />
    <SolidColorBrush x:Key="B.Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="B.BadBg" Color="{StaticResource C.BadBg}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerBorder" Color="{StaticResource C.DangerBorder}" />
    <SolidColorBrush x:Key="B.Rx" Color="{StaticResource C.Rx}" />
    <SolidColorBrush x:Key="B.Tx" Color="{StaticResource C.Tx}" />
    <SolidColorBrush x:Key="B.Purple" Color="{StaticResource C.Purple}" />
    <SolidColorBrush x:Key="B.Blue" Color="{StaticResource C.Blue}" />
    <SolidColorBrush x:Key="B.Orange" Color="{StaticResource C.Orange}" />
    <SolidColorBrush x:Key="B.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="B.ScrimSoft" Color="{StaticResource C.ScrimSoft}" />
    <SolidColorBrush x:Key="B.RowLine" Color="{StaticResource C.RowLine}" />
</ResourceDictionary>
